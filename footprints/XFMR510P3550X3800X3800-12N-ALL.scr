# XFMR510P3550X3800X3800-12N-ALL — PQ35/35 12핀 보빈 (T2·T4·T6·T8) — 전 핀 실장
# Ferroxcube CPV-PQ35/35-1S-12P-Z / TDK B65882B0012T001
# V2000 보빈 풋프린트 — 치수는 데이터시트 도면이 아니라 검색으로 얻은 치수표에서 왔다. 제작 전 원본 PDF 도면과 대조할 것.
# Allegro PCB Editor: File > Script > Play. 먼저 패드스택을 만들고 이름을 PADSTACK 에 넣을 것.
# 권장 패드스택: 드릴 1.30 mm 도금, 패드 ⌀2.60 mm, 안티패드 ⌀3.40 mm
setwindow pcb
units mm

define PADSTACK BOBBIN_D130_P260

add pin $PADSTACK 1 -15.0000 -17.7500 0
add pin $PADSTACK 2 -9.9000 -17.7500 0
add pin $PADSTACK 3 -4.8000 -17.7500 0
add pin $PADSTACK 4 4.8000 -17.7500 0
add pin $PADSTACK 5 9.9000 -17.7500 0
add pin $PADSTACK 6 15.0000 -17.7500 0
add pin $PADSTACK 7 15.0000 17.7500 0
add pin $PADSTACK 8 9.9000 17.7500 0
add pin $PADSTACK 9 4.8000 17.7500 0
add pin $PADSTACK 10 -4.8000 17.7500 0
add pin $PADSTACK 11 -9.9000 17.7500 0
add pin $PADSTACK 12 -15.0000 17.7500 0

# 조립 외곽 (Package Geometry/Assembly_Top)
# rectangle -19.00 -19.00 19.00 19.00
save
